# A separate listener/site; do not replace another project's server block.
server {
    listen 8443 ssl;
    server_name your-host.example;
    ssl_certificate /etc/letsencrypt/live/your-host.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-host.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;
    error_log /var/log/hsd-agent/nginx-error.log warn;

    # BEGIN HSD PROXY POLICY
    # Fully receive ordinary small request bodies before using a Gunicorn thread.
    client_max_body_size 64k;
    client_body_buffer_size 64k;
    client_body_temp_path /var/lib/hsd-agent/storage/nginx-body;
    client_body_timeout 15s;
    send_timeout 30s;

    proxy_http_version 1.1;
    proxy_request_buffering on;
    proxy_buffering on;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 300s;
    proxy_send_timeout 30s;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Connection "";

    location / {
        proxy_pass http://127.0.0.1:8830;
    }

    # Both normalized upload routes stream, including chunked bodies over HTTP/1.1.
    # The application checks ownership, multipart structure, disk and cancellation.
    location ~ ^/api/(?:jobs/upload|material/jobs)$ {
        if ($request_method != POST) { return 405; }
        client_max_body_size 0;
        client_body_timeout 300s;
        send_timeout 300s;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://127.0.0.1:8830;
    }

    location = /api/ribbon/assets {
        # The catalog remains readable. Reject unsupported methods before their bodies.
        if ($request_method !~ ^(?:GET|HEAD|POST)$) { return 405; }
        # Preserve the 20 MiB per-image limit plus the existing multipart allowance.
        client_max_body_size 21m;
        client_body_timeout 300s;
        send_timeout 300s;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://127.0.0.1:8830;
    }

    # Keep live progress and authorized files flowing without a proxy spool.
    location ~ ^/api/(?:jobs/[^/]+/(?:download|image/[^/]+/[^/]+)|material/jobs/[^/]+/(?:events|download(?:/[^/]+)?|source/[^/]+|item/[^/]+(?:/before)?)|ribbon/(?:assets/[^/]+/file|versions/[^/]+/(?:preview|view|download)))$ {
        send_timeout 300s;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://127.0.0.1:8830;
    }
    # END HSD PROXY POLICY
}
