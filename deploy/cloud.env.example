# Paths only. Never put API keys, passwords or employee access codes here.
HSD_PUBLIC_ORIGIN=https://your-host.example:8443
HSD_BIND_PORT=8830
HSD_DATA_DIR=/var/lib/hsd-agent/storage/data
HSD_SETTINGS_DIR=/var/lib/hsd-agent/settings
HSD_CREDENTIAL_KEY_FILE=/etc/hsd-agent/private/credential.key
HSD_ADMIN_CREDENTIAL_FILE=/etc/hsd-agent/private/admin.json
HSD_EMPLOYEE_CODE_FILE=/etc/hsd-agent/private/employee.code
# Optional instance override for an explicitly chosen employee access code.
# HSD_EMPLOYEE_CODE_MIN_LENGTH=16
